{
  "provider": "alibaba",
  "project": "grid-development",
  "region": "cn-hangzhou",
  "metadata": {
    "name": "example-network",
    "description": "Network fabric (Unit A): network + subnets. Module: alibaba/network",
    "environment": "development",
    "modulePath": "alibaba/network",
    "kind": "network"
  },
  "resources": [
    {
      "type": "network",
      "name": "example-network",
      "description": "network fabric",
      "role": "primary",
      "cidr": "60.0.0.0/16"
    },
    {
      "type": "subnet",
      "name": "example-network-public",
      "vpc": "example-network",
      "cidr": "60.0.1.0/24",
      "region": "cn-hangzhou",
      "description": "Public subnet",
      "role": "support"
    },
    {
      "type": "subnet",
      "name": "example-network-private",
      "vpc": "example-network",
      "cidr": "60.0.2.0/24",
      "region": "cn-hangzhou",
      "description": "Private subnet",
      "role": "support"
    }
  ]
}
