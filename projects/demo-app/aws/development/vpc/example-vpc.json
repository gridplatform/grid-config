{
  "provider": "aws",
  "project": "grid-development",
  "region": "us-east-1",
  "metadata": {
    "name": "example-vpc",
    "description": "Network fabric: vpc + subnets. Module: aws/vpc",
    "environment": "development",
    "modulePath": "aws/vpc",
    "kind": "vpc"
  },
  "resources": [
    {
      "type": "vpc",
      "name": "example-vpc",
      "description": "vpc fabric",
      "role": "primary",
      "cidr": "10.0.0.0/16"
    },
    {
      "type": "subnet",
      "name": "example-vpc-public",
      "vpc": "example-vpc",
      "cidr": "10.0.1.0/24",
      "region": "us-east-1",
      "description": "Public subnet",
      "role": "support"
    },
    {
      "type": "subnet",
      "name": "example-vpc-private",
      "vpc": "example-vpc",
      "cidr": "10.0.2.0/24",
      "region": "us-east-1",
      "description": "Private subnet",
      "role": "support"
    }
  ]
}
