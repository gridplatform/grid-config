{
  "provider": "aws",
  "project": "grid-production",
  "region": "us-east-1",
  "metadata": {
    "name": "example-security-group",
    "description": "Network control (Unit B): security-group. Module: aws/security-group",
    "environment": "production",
    "modulePath": "aws/security-group",
    "kind": "security-group",
    "dependsOn": [
      "aws/production/vpc/example-vpc.json"
    ]
  },
  "resources": [
    {
      "type": "security-group",
      "name": "example-security-group",
      "description": "Security group example",
      "vpc_id": "example-vpc",
      "role": "primary"
    }
  ]
}
