{
  "provider": "aws",
  "project": "grid-production",
  "region": "us-east-1",
  "metadata": {
    "name": "grid-production-vpc",
    "description": "Network fabric (Unit A): vpc + subnets. Module: aws/vpc",
    "environment": "production",
    "kind": "vpc",
    "modulePath": "aws/vpc"
  },
  "resources": [
    {
      "type": "vpc",
      "name": "grid-production-vpc",
      "description": "vpc fabric",
      "role": "primary",
      "cidr": "10.60.0.0/16"
    },
    {
      "type": "subnet",
      "name": "grid-production-nodes-a",
      "vpc": "grid-production-vpc",
      "cidr": "10.60.0.0/20",
      "region": "us-east-1",
      "description": "Private EKS nodes subnet (us-east-1a)",
      "role": "support"
    },
    {
      "type": "subnet",
      "name": "grid-production-nodes-b",
      "vpc": "grid-production-vpc",
      "cidr": "10.60.16.0/20",
      "region": "us-east-1",
      "description": "Private EKS nodes subnet (us-east-1b)",
      "role": "support"
    },
    {
      "type": "subnet",
      "name": "grid-production-nodes-c",
      "vpc": "grid-production-vpc",
      "cidr": "10.60.32.0/20",
      "region": "us-east-1",
      "description": "Private EKS nodes subnet (us-east-1c)",
      "role": "support"
    },
    {
      "type": "subnet",
      "name": "grid-production-public",
      "vpc": "grid-production-vpc",
      "cidr": "10.60.48.0/24",
      "region": "us-east-1",
      "description": "Public subnet for EC2 instance",
      "role": "support"
    }
  ]
}
