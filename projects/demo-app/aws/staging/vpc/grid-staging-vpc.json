{
  "provider": "aws",
  "project": "grid-staging",
  "region": "us-east-1",
  "metadata": {
    "name": "grid-staging-vpc",
    "description": "Network fabric: vpc + subnets. Module: aws/vpc",
    "environment": "staging",
    "kind": "vpc",
    "modulePath": "aws/vpc"
  },
  "resources": [
    {
      "type": "vpc",
      "name": "grid-staging-vpc",
      "description": "vpc fabric",
      "role": "primary",
      "cidr": "10.50.0.0/16"
    },
    {
      "type": "subnet",
      "name": "grid-staging-nodes-a",
      "vpc": "grid-staging-vpc",
      "cidr": "10.50.0.0/20",
      "region": "us-east-1",
      "description": "Private EKS nodes subnet (us-east-1a)",
      "role": "support"
    },
    {
      "type": "subnet",
      "name": "grid-staging-nodes-b",
      "vpc": "grid-staging-vpc",
      "cidr": "10.50.16.0/20",
      "region": "us-east-1",
      "description": "Private EKS nodes subnet (us-east-1b)",
      "role": "support"
    },
    {
      "type": "subnet",
      "name": "grid-staging-public",
      "vpc": "grid-staging-vpc",
      "cidr": "10.50.32.0/24",
      "region": "us-east-1",
      "description": "Public subnet for EC2 instance",
      "role": "support"
    }
  ]
}
