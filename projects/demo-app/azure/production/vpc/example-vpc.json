{
  "provider": "azure",
  "project": "grid-production",
  "region": "eastus",
  "metadata": {
    "name": "example-vpc",
    "description": "Network fabric: network + subnets. Module: azure/network",
    "environment": "production",
    "modulePath": "azure/network",
    "kind": "network"
  },
  "resources": [
    {
      "type": "network",
      "name": "example-vpc",
      "description": "network fabric",
      "role": "primary",
      "address_space": [
        "30.20.0.0/16"
      ]
    },
    {
      "type": "subnet",
      "name": "example-vpc-public",
      "vpc": "example-vpc",
      "cidr": "30.20.1.0/24",
      "region": "eastus",
      "description": "Public subnet",
      "role": "support"
    },
    {
      "type": "subnet",
      "name": "example-vpc-private",
      "vpc": "example-vpc",
      "cidr": "30.20.2.0/24",
      "region": "eastus",
      "description": "Private subnet",
      "role": "support"
    }
  ]
}
