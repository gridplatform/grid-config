{
  "provider": "gcp",
  "project": "REPLACE_GCP_PROJECT_DEVELOPMENT",
  "region": "us-central1",
  "metadata": {
    "name": "example-firewall",
    "description": "Network control (Unit B): firewall. Module: gcp/firewall",
    "environment": "development",
    "modulePath": "gcp/firewall",
    "dependsOn": [
      "gcp/development/vpc/example-vpc.json"
    ],
    "kind": "firewall"
  },
  "resources": [
    {
      "type": "firewall",
      "name": "example-firewall",
      "description": "VPC firewall rules example",
      "project_id": "REPLACE_GCP_PROJECT_DEVELOPMENT",
      "network": "example-vpc",
      "ingress_rules": [
        {
          "name": "example-firewall-allow-ssh",
          "source_ranges": [
            "0.0.0.0/0"
          ],
          "allow": [
            {
              "protocol": "tcp",
              "ports": [
                "22"
              ]
            }
          ]
        }
      ],
      "egress_rules": [],
      "role": "primary"
    }
  ]
}
