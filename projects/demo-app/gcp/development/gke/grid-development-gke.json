{
  "provider": "gcp",
  "project": "REPLACE_GCP_PROJECT_DEVELOPMENT",
  "region": "us-central1",
  "metadata": {
    "name": "grid-development-gke",
    "description": "GKE cluster with on-demand, spot, and GPU node pools (development)",
    "environment": "development",
    "dependsOn": ["gcp/development/vpc/grid-development-vpc.json"]
  },
  "resources": [
    {
      "type": "gke",
      "name": "grid-development-gke",
      "description": "Development GKE — private nodes, three node pools",
      "cluster_name": "grid-development-gke",
      "vpc": "grid-development-vpc",
      "subnet": "grid-development-nodes",
      "secondary_range_pod": "pods",
      "secondary_range_services": "services",
      "enable_private_nodes": true,
      "enable_private_endpoint": false,
      "deletion_protection": false,
      "release_channel": "REGULAR",
      "node_pools": {
        "ondemand": {
          "machine_type": "e2-standard-2",
          "disk_size_gb": 100,
          "disk_type": "pd-balanced",
          "node_lifecycle": "ON_DEMAND",
          "min_nodes": 0,
          "max_nodes": 3,
          "zones": ["us-central1-a", "us-central1-b"],
          "labels": {
            "pool": "ondemand",
            "environment": "development"
          }
        },
        "spot": {
          "machine_type": "e2-standard-2",
          "disk_size_gb": 100,
          "disk_type": "pd-balanced",
          "node_lifecycle": "SPOT",
          "min_nodes": 0,
          "max_nodes": 3,
          "zones": ["us-central1-a", "us-central1-b"],
          "labels": {
            "pool": "spot",
            "environment": "development"
          },
          "taints": [
            {
              "key": "spot",
              "value": "true",
              "effect": "NO_SCHEDULE"
            }
          ]
        },
        "gpu": {
          "machine_type": "n1-standard-4",
          "disk_size_gb": 100,
          "disk_type": "pd-balanced",
          "node_lifecycle": "ON_DEMAND",
          "min_nodes": 0,
          "max_nodes": 2,
          "zones": ["us-central1-a"],
          "labels": {
            "pool": "gpu",
            "environment": "development"
          },
          "taints": [
            {
              "key": "nvidia.com/gpu",
              "value": "present",
              "effect": "NO_SCHEDULE"
            }
          ],
          "guest_accelerator": {
            "type": "nvidia-tesla-t4",
            "count": 1
          }
        }
      }
    }
  ]
}
