{
  "provider": "gcp",
  "project": "REPLACE_GCP_PROJECT_PRODUCTION",
  "region": "us-central1",
  "metadata": {
    "name": "example-route",
    "description": "Network control (Unit B): route. Module: gcp/route",
    "environment": "production",
    "modulePath": "gcp/route",
    "dependsOn": [
      "gcp/production/vpc/example-vpc.json"
    ],
    "kind": "route"
  },
  "resources": [
    {
      "type": "route",
      "name": "example-route",
      "description": "Custom VPC route example",
      "project_id": "REPLACE_GCP_PROJECT_PRODUCTION",
      "network": "example-vpc",
      "routes": [
        {
          "name": "example-route",
          "dest_range": "0.0.0.0/0",
          "next_hop_gateway": "default-internet-gateway"
        }
      ],
      "role": "primary"
    }
  ]
}
