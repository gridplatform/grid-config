{
  "provider": "aws",
  "project": "grid-labs",
  "region": "us-east-1",
  "metadata": {
    "name": "grid-labs-vm",
    "description": "t3.micro lab VM (hosts Grid later)",
    "environment": "development",
    "dependsOn": ["aws/development/vpc/grid-labs-vpc.json"]
  },
  "resources": [
    {
      "type": "security-group",
      "name": "grid-labs-ssh",
      "vpc": "grid-labs-vpc",
      "description": "SSH and Grid ports",
      "ingress_rules": [
        {
          "from_port": 22,
          "to_port": 22,
          "protocol": "tcp",
          "cidr_blocks": ["0.0.0.0/0"],
          "description": "SSH"
        },
        {
          "from_port": 3000,
          "to_port": 3000,
          "protocol": "tcp",
          "cidr_blocks": ["0.0.0.0/0"],
          "description": "grid-core"
        }
      ],
      "egress_rules": [
        {
          "from_port": 0,
          "to_port": 0,
          "protocol": "-1",
          "cidr_blocks": ["0.0.0.0/0"]
        }
      ]
    },
    {
      "type": "vm",
      "name": "grid-labs-vm",
      "machineType": "t3.micro",
      "subnet": "grid-labs-public",
      "securityGroups": ["grid-labs-ssh"],
      "associate_public_ip_address": true,
      "diskSize": 8,
      "tags": ["grid", "labs"],
      "description": "Small lab VM"
    }
  ]
}
