{
  "provider": "aws",
  "project": "grid-labs",
  "region": "us-east-1",
  "metadata": {
    "name": "grid-labs-vpc",
    "description": "Network fabric (Unit A): vpc + subnets. Module: aws/vpc",
    "environment": "development",
    "kind": "vpc",
    "modulePath": "aws/vpc"
  },
  "resources": [
    {
      "type": "vpc",
      "name": "grid-labs-vpc",
      "description": "vpc fabric",
      "role": "primary",
      "cidr": "10.50.0.0/16"
    },
    {
      "type": "subnet",
      "name": "grid-labs-public",
      "vpc": "grid-labs-vpc",
      "cidr": "10.50.1.0/24",
      "region": "us-east-1",
      "description": "Public subnet us-east-1a",
      "role": "support"
    }
  ]
}
