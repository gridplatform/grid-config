{
  "provider": "aws",
  "project": "grid-labs",
  "region": "us-east-1",
  "metadata": {
    "name": "grid-labs-vpc",
    "description": "Cheap public-only VPC (no NAT)",
    "environment": "development"
  },
  "resources": [
    {
      "type": "vpc",
      "name": "grid-labs-vpc",
      "cidr": "10.50.0.0/16",
      "enable_nat_gateway": false,
      "private_subnets": [],
      "map_public_ip_on_launch": true,
      "description": "Lab VPC"
    },
    {
      "type": "subnet",
      "name": "grid-labs-public",
      "vpc": "grid-labs-vpc",
      "cidr": "10.50.1.0/24",
      "region": "us-east-1",
      "description": "Public subnet us-east-1a"
    }
  ]
}
